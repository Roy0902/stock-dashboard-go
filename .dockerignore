# Build context hygiene. Secrets and runtime state must never enter the image.
.git
.gitignore
.github
.dev
.env
.env.*
data
docs
e2e
node_modules
web/node_modules
web/dist
server/bin
server/internal/webui/dist
**/*.log
**/.DS_Store
**/Thumbs.db
test-results
playwright-report
**/*_test.go
**/*.test.ts
**/*.test.tsx
web/src/test
web/vitest.setup.ts
coverage
web/coverage
*.md
!web/package.json
!web/package-lock.json
