# Copy this file to .env for local runs. Never commit .env.
# scripts/*.ps1 load this file before starting the server; a real environment
# variable with the same name wins over the value here.

# --- Provider keys: required for quotes and charts, optional for startup ---
# Finnhub key, used as the primary quote source. Never logged or returned.
FINNHUB_API_KEY=
# Twelve Data key, used for fallback quotes and as the only chart source.
TWELVEDATA_API_KEY=

# --- Server: optional, defaults shown ---
# PORT=3000                                     # listen port, 1-65535
# BIND_HOST=127.0.0.1                           # listen IP; the image sets 0.0.0.0
# DATA_DIR=./data                               # holds stock-dashboard.db; relative to the process CWD
# AUTH_COOKIE_SECURE=false                      # true adds Secure to auth cookies; required over HTTPS
# ALLOWED_HOSTS=127.0.0.1,localhost,::1         # accepted Host headers; hostnames/IPs, no scheme or port
# FINNHUB_RPM=55                                # Finnhub calls per minute
# TWELVEDATA_RPM=7                              # Twelve Data calls per minute
# UPSTREAM_TIMEOUT=2s                           # per-request upstream timeout (Go duration)
# QUOTE_CACHE_TTL=1m                            # quote cache lifetime (Go duration)
# FINNHUB_BASE_URL=https://finnhub.io           # base URL override, for tests only
# TWELVEDATA_BASE_URL=https://api.twelvedata.com  # base URL override, for tests only

# --- Dev only: not read by the Go server ---
# API_PORT=3000                                 # Vite proxy target, read by web/vite.config.ts
