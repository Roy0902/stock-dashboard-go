      "dot": "emerald",
      "title": "New hash path",
      "items": [
        "PBKDF2-HMAC-SHA256, 600,000 iterations",
        "16-byte random salt, 32-byte key",
        "CPU-only; no 64 MiB per-hash work area"
      ]
    },
    {
      "dot": "amber",
      "title": "Legacy upgrade",
      "items": [
        "Argon2id records still verify",
        "Successful password login rewrites them to PBKDF2",
        "A failed rewrite is ignored and retried next login"
      ]
    },
