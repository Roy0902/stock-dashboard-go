      "dot": "rose",
      "title": "Gates and session",
      "items": [
        "5 failures / 15 min; 60 global attempts / min; 2 verify slots",
        "5-minute challenge; TOTP step replay rejected",
        "12 h absolute / 30 min idle session"
      ]
